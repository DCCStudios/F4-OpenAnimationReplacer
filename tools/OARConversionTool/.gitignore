# Build artifacts (regenerated by build_exe.bat / PyInstaller)
build/
dist/
*.spec

# Runtime logs written next to the exe/script (local file paths, not source)
logs/

# BA2 archive extraction scratch space: holds real, possibly copyrighted mod content
# extracted from a user's own archives. Never committed.
BA2_Extracted/

# Python bytecode cache
__pycache__/
*.pyc

# Test fixtures: full copies of third-party Tactical Reload weapon mods (SCAR-H, Sig Sauer
# Pack), including their .esp files and ~190MB of .hkx animation data. These are someone
# else's shipped mod content used only to exercise the conversion pipeline locally; they are
# not code this project authored and must never be pushed to the public repo. To run
# smoke_test.py / verification_test.py locally, populate this folder yourself from those mods.
TestAssets/
